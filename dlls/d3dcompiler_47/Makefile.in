MODULE    = d3dcompiler_47.dll
IMPORTLIB = d3dcompiler
IMPORTS   = wined3d
EXTRADEFS = -DD3D_COMPILER_VERSION=47
PARENTSRC = ../d3dcompiler_43
# wineweb (fd3dc): the wasm builtin staticlib flavor (the d3d9/dxgi
# precedent). The sources are the PARENTSRC d3dcompiler_43 set — the HLSL
# compile rides the bundled vkd3d-shader (compiler.c's vkd3d_D3DCompile2VKD3D
# hop, blob.c's vkd3d_shader_parse_dxbc) — so the include path must name the
# in-tree vkd3d headers: on the wasm configure there is no mingw, so
# VKD3D_PE_CFLAGS is empty and the headers are unfindable without this.
STATICLIB = libd3dcompiler_47.a
EXTRAINCL = -I$(top_srcdir)/libs/vkd3d/include $(VKD3D_PE_CFLAGS)

VER_FILEDESCRIPTION_STR = "Wine D3DCompiler"
VER_PRODUCTVERSION      = 6,3,9600,16984

SOURCES = \
	asmparser.c \
	asmshader.l \
	asmshader.y \
	blob.c \
	bytecodewriter.c \
	compiler.c \
	linker.c \
	reflection.c \
	utils.c
